local function getSpinArg(spinType)
    local playerRankValue = getRankValue(currentRank)
    local bestArg = nil
    local bestRankValue = 0
    if spinArgsMap[spinType] then
        local ranksToCheck = {}
        for rankName, _ in pairs(spinArgsMap[spinType]) do
            table.insert(ranksToCheck, rankName)
        end
        table.sort(ranksToCheck, function(a, b) return getRankValue(a) > getRankValue(b) end)
        for _, rankName in ipairs(ranksToCheck) do
            local requiredRankValue = getRankValue(rankName)
            if playerRankValue >= requiredRankValue then
                bestArg = spinArgsMap[spinType][rankName]
                break
            end
        end
    end
    return bestArg
end
local function checkRankAndNotify(spinType)
    local rankValue = getRankValue(currentRank)
    if spinType == "LUCKY SPIN" then
        if rankValue < getRankValue("bronze ii") then
            Window:Notify({
                Title = "Requisito de Rank",
                Description = "VOCÊ PRECISA ESTAR NO BRONZE II pelo menos para USAR ESSA FUNÇÃO",
                Duration = 5,
                Type = "Warning"
            })
            return false
        end
    elseif spinType == "HAB SPIN" then
        if rankValue < getRankValue("prata ii") then
            Window:Notify({
                Title = "Requisito de Rank",
                Description = "PARA USAR ESSA FUNÇÃO VOCÊ PRECISA ESTAR PELO MENOS NO RANK PRATA II",
                Duration = 5,
                Type = "Warning"
            })
            return false
        end
    end
    return true
end
local function createSpinToggle(name, description, spinType)
    local loopConnection = nil
    MainTab:New("Toggle")({
        Title = name,
        Description = description,
        DefaultValue = false,
        Callback = function(Value)
            if Value then
                if checkRankAndNotify(spinType) then
                    local argValue = getSpinArg(spinType)
                    if argValue then
                        loopConnection = task.spawn(function()
                            while Value do
                                local args = {[1] = argValue}
                                ReplicatedStorage.Packages._Index:FindFirstChild("sleitnick_knit@1.7.0").knit.Services.SeasonService.RF.RequestRankedReward:InvokeServer(unpack(args))
                                task.wait(4)
                            end
                        end)
                    else
                        Window:Notify({
                            Title = "Erro",
                            Description = "Função não disponível para o seu rank atual ou rank não reconhecido.",
                            Duration = 5,
                            Type = "Error"
                        })
                    end
                else
                    return false
                end
            else
                if loopConnection then
                    task.cancel(loopConnection)
                    loopConnection = nil
                end
            end
        end,
    })
end
