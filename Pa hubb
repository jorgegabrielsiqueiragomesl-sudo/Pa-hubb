local function getRankValue(rankName)
    local lowerRankName = string.lower(rankName)
    local value = rankOrder[lowerRankName]
    if value then
        return value
    else
        return rankOrder["diamante iii"]
    end
end
local function checarLabel(label)
    if label:IsA("TextLabel") or label:IsA("TextBox") or label:IsA("TextButton") then
        local textoOriginal = label.Text
        local textoMinusculo = string.lower(textoOriginal)
        if string.find(textoMinusculo, "highest rank") then
            local partes = string.split(textoOriginal, ":")
            if partes[2] then
                local extractedRank = string.gsub(partes[2], "^%s*(.-)%s*$", "%1")
                local normalizedRank = string.lower(extractedRank)
                normalizedRank = string.gsub(normalizedRank, "/%s*%d+", "")
                currentRank = string.gsub(normalizedRank, "^%s*(.-)%s*$", "%1")
            end
        end
    end
end
